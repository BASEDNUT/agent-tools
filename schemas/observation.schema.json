{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:basednut:orchard:observation:draft:0.1",
  "title": "Rootstock/Orchard observation prototype (not production contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chainId",
    "vault",
    "pool",
    "metric",
    "status",
    "value",
    "source"
  ],
  "properties": {
    "chainId": {
      "enum": [
        8453,
        84532
      ]
    },
    "vault": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "pool": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "observed",
        "derived",
        "partial",
        "stale",
        "unavailable",
        "synthetic"
      ]
    },
    "value": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "unit": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceClass",
        "chainId"
      ],
      "properties": {
        "sourceClass": {
          "enum": [
            "chain",
            "derived",
            "synthetic",
            "none"
          ]
        },
        "chainId": {
          "enum": [
            8453,
            84532
          ]
        },
        "blockNumber": {
          "type": "integer",
          "minimum": 0
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "rpc": {
          "type": "string"
        },
        "methodVersion": {
          "type": "string"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "total"
      ],
      "properties": {
        "available": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "source": {
            "properties": {
              "sourceClass": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "observed",
              "derived",
              "partial",
              "stale"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "required": [
              "blockNumber",
              "blockHash",
              "asOf",
              "methodVersion"
            ],
            "properties": {
              "sourceClass": {
                "enum": [
                  "chain",
                  "derived"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "synthetic"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sourceClass": {
                "const": "synthetic"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "required": [
          "coverage"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              }
            ]
          },
          "source": {
            "properties": {
              "sourceClass": {
                "const": "chain"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "derived"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              }
            ]
          },
          "source": {
            "properties": {
              "sourceClass": {
                "const": "derived"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "stale"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              }
            ]
          }
        }
      }
    }
  ]
}
